# ---------------------------------------------------------------------------
# Nudge — environment
#
# Every variable here is optional in development. With an empty .env the app
# boots on an embedded Postgres (PGlite) with a dev auth adapter, so you can
# run it with no accounts and no Docker. Production requires the real ones and
# refuses to start without them.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Unset in dev  -> embedded PGlite at .pglite/ (zero setup, real Postgres).
# Set           -> node-postgres locally, Neon serverless on Vercel.
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Auth (Clerk) ----------------------------------------------------------
# Unset in dev  -> dev auth adapter, single seeded user, no sign-in screen.
# Both required together; setting only one is a hard error.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# Who the dev auth adapter signs you in as. All optional.
# DEV_USER_NAME="You"
# DEV_USER_EMAIL="you@example.com"
# DEV_ORG_NAME="Your business"
# DEV_TIMEZONE="UTC"          # what "today" means for aging

# --- Mail (Phase 3) --------------------------------------------------------
# MAIL_MODE defaults to "sandbox" everywhere except production (D-014).
# The transport refuses any recipient outside the allowlist while sandboxed.
# MAIL_MODE="sandbox"
# MAIL_SANDBOX_ALLOWLIST="you@example.com"

# --- Phase 4+ --------------------------------------------------------------
# ANTHROPIC_API_KEY=""
# STRIPE_SECRET_KEY=""            # our billing
# STRIPE_WEBHOOK_SECRET=""
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
